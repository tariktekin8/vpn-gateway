systems.json
docker-compose.generated.json
.secrets/
wireguard/

# Python
__pycache__/
*.pyc

# macOS and editors
.DS_Store
.claude/
.vscode/
.idea/

# Left behind if a save is killed midway; holds the full systems.json
.systems.*.tmp

# Node, only for building the web UI
node_modules/

# Tests: local only, not published
tests/
